---
import Base from '../layouts/Base.astro';
import Install from '../components/Install.astro';
import { features, platforms, platformMatrix } from '../data/features';
import { url, REPO } from '../lib/url';
---
<Base>
  <section class="hero container">
    <div class="copy stack">
      <span class="eyebrow">Plugin for coding agents</span>
      <h1>Skills, agents, and hooks for coding agents.</h1>
      <p class="lede">A backlog and a loop that builds it, a plan outline that survives <code>/clear</code>, modes for careful and rapid work, and unattended runs that finish a task through pull requests.</p>
      <Install />
      <p class="other">On OpenCode, Codex, Cursor, or Antigravity? See <a href={`${REPO}#install`}>install for each agent</a>.</p>
      <div class="ctas">
        <a class="button" href={url('/features')}>See the features</a>
        <a class="button ghost" href={REPO}>GitHub</a>
      </div>
    </div>
    <div class="art" aria-hidden="true">
      <img src={url('/waffles-512.png')} width="512" height="512" alt="" />
    </div>
  </section>

  <section class="container tiles" aria-label="Features">
    {features.map((f) => (
      <a class="tile" href={url(`/features#${f.id}`)}>
        <h3>{f.name}</h3>
        <p>{f.summary}</p>
      </a>
    ))}
  </section>

  <section class="container platforms stack">
    <span class="eyebrow">Platforms</span>
    <h2>One skills folder, five agents.</h2>
    <p>Skills follow the open Agent Skills format, so they load on any agent that reads it. The hooks reach each agent through its own adapter.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th scope="col">Feature</th>{platforms.map((p) => <th scope="col">{p}</th>)}</tr></thead>
        <tbody>
          {platformMatrix.map((r) => <tr><th scope="row">{r.feature}</th>{r.cells.map((c) => <td class={c === 'No' ? 'no' : ''}>{c}</td>)}</tr>)}
        </tbody>
      </table>
    </div>
  </section>
</Base>
<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 3rem; align-items: center; padding-block: 4.5rem 3.5rem; }
  .copy { gap: 1.25rem; }
  .other { font-size: 0.92rem; color: var(--ink-muted); }
  .ctas { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .art { position: relative; display: grid; place-items: center; }
  .art::before { content: ''; position: absolute; width: 88%; aspect-ratio: 1; border-radius: 50%; background: var(--disc); }
  .art img { position: relative; width: 100%; max-width: 440px; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; }
  .tile { display: grid; gap: 0.4rem; align-content: start; padding: 1.1rem 1.2rem; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .tile:hover { border-color: var(--link); }
  .tile p { font-size: 0.92rem; color: var(--ink-muted); }
  .platforms { margin-top: 5rem; }
  td.no { color: var(--ink-muted); }
  @media (max-width: 820px) {
    .hero { grid-template-columns: minmax(0, 1fr); padding-block: 2.5rem; }
    .art { order: -1; max-width: 260px; justify-self: center; }
  }
</style>
