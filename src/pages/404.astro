---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---
<Base title="Page not found">
  <section class="container stack nf">
    <span class="eyebrow">404</span>
    <h1>This page is not on the plate.</h1>
    <p><a href={url('/')}>Go to the home page</a> or <a href={url('/features')}>see the features</a>.</p>
  </section>
</Base>
<style>.nf { padding-block: 6rem; }</style>
