---
/** Flat waffle mark for small sizes (nav, favicon). The 3D icon is for large sizes. */
interface Props { size?: number }
const { size = 28 } = Astro.props;
const cells = [0, 1, 2, 3].flatMap((r) => [0, 1, 2, 3].map((c) => ({ x: 4.4 + c * 5.25, y: 8.4 + r * 5.25 })));
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect x="7" y="2" width="23" height="23" rx="4.5" fill="#D18B2C" />
  <rect x="2" y="6" width="25" height="25" rx="4.5" fill="#EDA845" />
  {cells.map(({ x, y }) => <rect x={x} y={y} width="4" height="4" rx=".9" fill="#C27A1E" />)}
</svg>
